# Adresse du site, sans / final (ex : https://premier-strats.vercel.app)
SITE_URL=
# Application Discord (portail développeur > OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Token du bot CloudyBot : sert à vérifier les rôles du joueur sur le serveur
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Rôles qui donnent accès au site (🏆・Premier et 🎙️・IGL), séparés par des virgules
ALLOWED_ROLE_IDS=1573715870822178907,1573715872785371187
# Longue chaîne aléatoire pour signer les sessions
SESSION_SECRET=
# Compte de service Firebase (le même projet que le bot)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Clé HenrikDev (la même que le bot) : lit le rang en jeu
HENRIKDEV_API_KEY=
